<bpmndi:BPMNShape id="E_reject_di" bpmnElement="E_reject"><dc:Bounds x="920" y="342" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="890.0" y="384" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
