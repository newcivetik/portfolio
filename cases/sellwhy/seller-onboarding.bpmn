<bpmndi:BPMNShape id="SP_pay_di" bpmnElement="SP_pay" isExpanded="false"><dc:Bounds x="1040" y="560" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T_access_di" bpmnElement="T_access"><dc:Bounds x="1210" y="560" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="E_done_di" bpmnElement="E_done"><dc:Bounds x="1380" y="582" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1350.0" y="624" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
