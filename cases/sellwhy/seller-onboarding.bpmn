<bpmndi:BPMNShape id="Lane_system_di" bpmnElement="Lane_system" isHorizontal="true"><dc:Bounds x="70" y="470" width="1410" height="260" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P_start_di" bpmnElement="P_start"><dc:Bounds x="100" y="342" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="70.0" y="384" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
