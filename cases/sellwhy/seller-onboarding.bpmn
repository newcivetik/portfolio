<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs" targetNamespace="https://github.com/newcivetik/portfolio">
<bpmn:collaboration id="Collab">
<bpmn:participant id="Seller" name="Продавец" />
<bpmn:participant id="Platform" name="Платформа SellWhy" processRef="Proc" />
<bpmn:messageFlow id="m1" name="Заявка (бренд, контакты, тариф)" sourceRef="Seller" targetRef="P_start" />
<bpmn:messageFlow id="m2" name="Запрос на доработку" sourceRef="T_rework" targetRef="Seller" />
<bpmn:messageFlow id="m3" name="Исправленные данные" sourceRef="Seller" targetRef="C_fixed" />
<bpmn:messageFlow id="m4" name="Отказ" sourceRef="T_reject" targetRef="Seller" />
<bpmn:messageFlow id="m5" name="Доступ к магазину" sourceRef="T_access" targetRef="Seller" />
</bpmn:collaboration>
<bpmn:process id="Proc" name="Зарегистрировать продавца и создать магазин" isExecutable="false">
<bpmn:laneSet id="LS">
<bpmn:lane id="Lane_support" name="Поддержка">
<bpmn:flowNodeRef>P_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>P_merge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_check</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_check</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_rework</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C_fixed</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_reject</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E_reject</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_system" name="Система">
<bpmn:flowNodeRef>T_activate</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_split</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_domain</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_qr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_join</bpmn:flowNodeRef>
<bpmn:flowNodeRef>SP_setup</bpmn:flowNodeRef>
<bpmn:flowNodeRef>SP_pay</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_access</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E_done</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="P_start" name="Заявка получена"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:messageEventDefinition id="P_start_md" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="P_merge" name=""><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T_check" name="Проверить данные заявки"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_check" name="Результат проверки?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T_rework" name="Запросить доработку"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="C_fixed" name="Исправленные данные получены"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:messageEventDefinition id="C_fixed_md" /></bpmn:intermediateCatchEvent>
<bpmn:sendTask id="T_reject" name="Сообщить об отказе"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="E_reject" name="Заявка отклонена"><bpmn:incoming>f8</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="T_activate" name="Активировать магазин"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:parallelGateway id="G_split" name=""><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:serviceTask id="T_domain" name="Создать поддомен"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_qr" name="Сгенерировать QR-знаки"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:parallelGateway id="G_join" name=""><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:subProcess id="SP_setup" name="Настроить магазин"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:subProcess>
<bpmn:subProcess id="SP_pay" name="Подключить оплату и доставку"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:subProcess>
<bpmn:sendTask id="T_access" name="Отправить продавцу доступ"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="E_done" name="Магазин создан"><bpmn:incoming>f18</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="P_start" targetRef="P_merge" />
<bpmn:sequenceFlow id="f2" sourceRef="P_merge" targetRef="T_check" />
<bpmn:sequenceFlow id="f3" sourceRef="T_check" targetRef="G_check" />
<bpmn:sequenceFlow id="f4" name="нужна доработка" sourceRef="G_check" targetRef="T_rework" />
<bpmn:sequenceFlow id="f5" sourceRef="T_rework" targetRef="C_fixed" />
<bpmn:sequenceFlow id="f6" sourceRef="C_fixed" targetRef="P_merge" />
<bpmn:sequenceFlow id="f7" name="отклонить" sourceRef="G_check" targetRef="T_reject" />
<bpmn:sequenceFlow id="f8" sourceRef="T_reject" targetRef="E_reject" />
<bpmn:sequenceFlow id="f9" name="корректны" sourceRef="G_check" targetRef="T_activate" />
<bpmn:sequenceFlow id="f10" sourceRef="T_activate" targetRef="G_split" />
<bpmn:sequenceFlow id="f11" sourceRef="G_split" targetRef="T_domain" />
<bpmn:sequenceFlow id="f12" sourceRef="G_split" targetRef="T_qr" />
<bpmn:sequenceFlow id="f13" sourceRef="T_domain" targetRef="G_join" />
<bpmn:sequenceFlow id="f14" sourceRef="T_qr" targetRef="G_join" />
<bpmn:sequenceFlow id="f15" sourceRef="G_join" targetRef="SP_setup" />
<bpmn:sequenceFlow id="f16" sourceRef="SP_setup" targetRef="SP_pay" />
<bpmn:sequenceFlow id="f17" sourceRef="SP_pay" targetRef="T_access" />
<bpmn:sequenceFlow id="f18" sourceRef="T_access" targetRef="E_done" />
</bpmn:process>
<bpmndi:BPMNDiagram id="Diag"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
<bpmndi:BPMNShape id="Seller_di" bpmnElement="Seller" isHorizontal="true"><dc:Bounds x="40" y="40" width="1440" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Platform_di" bpmnElement="Platform" isHorizontal="true"><dc:Bounds x="40" y="170" width="1440" height="560" /></bpmndi:BPMNShape>
