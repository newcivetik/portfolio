<bpmndi:BPMNShape id="T_domain_di" bpmnElement="T_domain"><dc:Bounds x="630" y="500" width="120" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T_qr_di" bpmnElement="T_qr"><dc:Bounds x="630" y="630" width="120" height="70" /></bpmndi:BPMNShape>
